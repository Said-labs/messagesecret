<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SecretWall — Analytics</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" type="image/png" href="/uploads/logo.png">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
  <style>
    .analytics { max-width: 1050px; width: 94%; margin: 30px auto; }
    .section-title {
      font-family: var(--font-display); color: var(--accent-2);
      margin: 26px 0 12px; font-size: 1.05rem;
    }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(165px, 1fr));
      gap: 14px;
    }
    .stat-card {
      background: var(--card-bg); border-radius: 12px; padding: 16px;
      box-shadow: 0 0 15px rgba(163, 191, 250, 0.25);
      transition: transform .2s ease, box-shadow .25s ease;
      animation: fadeIn .6s ease forwards;
    }
    .stat-card:hover { transform: translateY(-4px); box-shadow: 0 14px 28px rgba(102, 126, 234, .3); }
    .stat-card .label { font-size: 12.5px; color: #888; margin-bottom: 6px; }
    .stat-card .value {
      font-family: var(--font-display); font-size: 1.8rem; font-weight: 700;
      background: linear-gradient(90deg, #667eea, #764ba2);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }
    .stat-card .hint { font-size: 11.5px; color: #999; margin-top: 4px; min-height: 14px; }
    .stat-card.total { grid-column: 1 / -1; text-align: center; }
    .stat-card.total .value { font-size: 2.8rem; }

    .charts-grid { display: grid; grid-template-columns: 1fr; gap: 18px; }
    @media (min-width: 900px) {
      .charts-grid { grid-template-columns: 1fr 1fr; }
      .charts-grid .wide { grid-column: 1 / -1; }
    }
    .chart-card, .list-card {
      background: var(--card-bg); border-radius: 12px; padding: 18px;
      box-shadow: 0 0 15px rgba(163, 191, 250, .25);
    }
    .chart-card h3, .list-card h3 { margin: 0 0 12px; font-family: var(--font-display); color: var(--accent-2); font-size: 1rem; }
    .chart-box { position: relative; height: 250px; }
    .chart-box.small { height: 220px; }

    .range-switch { display: inline-flex; gap: 6px; margin-bottom: 10px; }
    .range-switch button {
      border: 2px solid #a3bffa; background: transparent; color: var(--accent);
      border-radius: 6px; padding: 4px 12px; cursor: pointer; font-family: var(--font-body);
    }
    .range-switch button.active { background: var(--accent); color: #fff; border-color: var(--accent); }

    .lists-grid { display: grid; grid-template-columns: 1fr; gap: 18px; }
    @media (min-width: 900px) { .lists-grid { grid-template-columns: repeat(3, 1fr); } }
    .rank { list-style: none; margin: 0; padding: 0; }
    .rank li {
      display: flex; justify-content: space-between; gap: 10px;
      padding: 8px 0; border-bottom: 1px solid rgba(163, 191, 250, .25);
      font-size: 13.5px; color: #444;
    }
    .rank li:last-child { border-bottom: none; }
    .rank .txt { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .rank .num {
