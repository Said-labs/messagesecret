<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SecretWall — Analytics</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" type="image/png" href="/uploads/logo.png">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
  <style>
    .analytics { max-width: 1050px; width: 94%; margin: 30px auto; }
    .section-title {
      font-family: var(--font-display); color: var(--accent-2);
      margin: 26px 0 12px; font-size: 1.05rem;
    }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(165px, 1fr));
      gap: 14px;
    }
    .stat-card {
      background: var(--card-bg); border-radius: 12px; padding: 16px;
      box-shadow: 0 0 15px rgba(163, 191, 250, 0.25);
      transition: transform .2s ease, box-shadow .25s ease;
      animation: fadeIn .6s ease forwards;
    }
    .stat-card:hover { transform: translateY(-4px); box-shadow: 0 14px 28px rgba(102, 126, 234, .3); }
    .stat-card .label { font-size: 12.5px; color: #888; margin-bottom: 6px; }
    .stat-card .value {
      font-family: var(--font-display); font-size: 1.8rem; font-weight: 700;
      background: linear-gradient(90deg, #667eea, #764ba2);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }
    .stat-card .hint { font-size: 11.5px; color: #999; margin-top: 4px; min-height: 14px; }
    .stat-card.total { grid-column: 1 / -1; text-align: center; }
    .stat-card.total .value { font-size: 2.8rem; }

    .charts-grid { display: grid; grid-template-columns: 1fr; gap: 18px; }
    @media (min-width: 900px) {
      .charts-grid { grid-template-columns: 1fr 1fr; }
      .charts-grid .wide { grid-column: 1 / -1; }
    }
    .chart-card, .list-card {
      background: var(--card-bg); border-radius: 12px; padding: 18px;
      box-shadow: 0 0 15px rgba(163, 191, 250, .25);
    }
    .chart-card h3, .list-card h3 { margin: 0 0 12px; font-family: var(--font-display); color: var(--accent-2); font-size: 1rem; }
    .chart-box { position: relative; height: 250px; }
    .chart-box.small { height: 220px; }

    .range-switch { display: inline-flex; gap: 6px; margin-bottom: 10px; }
    .range-switch button {
      border: 2px solid #a3bffa; background: transparent; color: var(--accent);
      border-radius: 6px; padding: 4px 12px; cursor: pointer; font-family: var(--font-body);
    }
    .range-switch button.active { background: var(--accent); color: #fff; border-color: var(--accent); }

    .lists-grid { display: grid; grid-template-columns: 1fr; gap: 18px; }
    @media (min-width: 900px) { .lists-grid { grid-template-columns: repeat(3, 1fr); } }
    .rank { list-style: none; margin: 0; padding: 0; }
    .rank li {
      display: flex; justify-content: space-between; gap: 10px;
      padding: 8px 0; border-bottom: 1px solid rgba(163, 191, 250, .25);
      font-size: 13.5px; color: #444;
    }
    .rank li:last-child { border-bottom: none; }
    .rank .txt { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .rank .num { font-weight: bold; color: var(--accent); flex: 0 0 auto; }
    .empty { color: #999; font-size: 13px; padding: 6px 0; }
    .state-msg { text-align: center; color: #888; padding: 30px 0; }
    .updated { text-align: center; font-size: 12px; color: #999; margin-top: 22px; }
  </style>
</head>
<body>

<aside class="iconbar">
  <div class="iconbar__header">
    <div class="iconbar__brand">
      <svg class="iconbar__mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" width="20" height="20"><path d="M12 2 3 12l9 10 9-10z"/><circle cx="12" cy="12" r="2.4" fill="currentColor" stroke="none"/></svg>
      <span class="iconbar__brand-text">SA'ID AZIZ</span>
    </div>
    <button class="iconbar__toggle" aria-label="Buka/tutup navbar">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="3" x2="9" y2="21"/></svg>
    </button>
  </div>

  <nav class="iconbar__nav">
    <a class="iconbar__item" href="/">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <span class="iconbar__label">Home</span>
      <span class="iconbar__tooltip">Home</span>
    </a>
    <a class="iconbar__item active" href="/analytics">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="20" x2="4" y2="12"/><line x1="10" y1="20" x2="10" y2="6"/><line x1="16" y1="20" x2="16" y2="14"/><line x1="21" y1="20" x2="21" y2="9"/></svg>
      <span class="iconbar__label">Analytics</span>
      <span class="iconbar__tooltip">Analytics</span>
    </a>
  </nav>

  <div class="iconbar__bottom">
    <button class="iconbar__item iconbar__item--menu" id="menuToggle" type="button">
      <svg viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/></svg>
      <span class="iconbar__label">Menu</span>
      <span class="iconbar__tooltip">Menu</span>
    </button>
  </div>
</aside>

<div class="menu-popup" id="menuPopup">
  <a class="menu-popup__item" href="https://mail.google.com/mail/?view=cm&fs=1&to=saidaziz.expert@gmail.com&su=Support%20SecretWall" target="_blank" rel="noopener">Support</a>
  <a class="menu-popup__item" href="/about">About</a>
  <a class="menu-popup__item" href="/terms">Terms</a>
  <div class="menu-popup__footer">SecretWall v1.0 &middot; Rilis 2026</div>
</div>

<main class="page">
  <header>
    <h1>Analytics SecretWall</h1>
    <p style="margin:0;color:#667;">Ringkasan pesan, komentar, dan interaksi yang masuk</p>
  </header>

  <section class="analytics">
    <div id="stateMsg" class="state-msg">Memuat data…</div>

    <div id="content" style="display:none;">
      <h2 class="section-title">📩 Pesan</h2>
      <div class="stats-grid" id="gridMessages"></div>

      <h2 class="section-title">💬 Komentar &amp; Interaksi</h2>
      <div class="stats-grid" id="gridComments"></div>

      <h2 class="section-title">📊 Grafik</h2>
      <div class="charts-grid">
        <div class="chart-card wide">
          <h3>Pesan &amp; Komentar per Hari</h3>
          <div class="range-switch" id="rangeSwitch">
            <button data-range="7">7 hari</button>
            <button data-range="14" class="active">14 hari</button>
            <button data-range="30">30 hari</button>
          </div>
          <div class="chart-box"><canvas id="chartDaily"></canvas></div>
        </div>
        <div class="chart-card">
          <h3>Pesan per Hari dalam Seminggu</h3>
          <div class="chart-box"><canvas id="chartWeekday"></canvas></div>
        </div>
        <div class="chart-card">
          <h3>Pesan per Jam (WIB)</h3>
          <div class="chart-box"><canvas id="chartHour"></canvas></div>
        </div>
        <div class="chart-card">
          <h3>Anonim vs Bernama</h3>
          <div class="chart-box small"><canvas id="chartAnon"></canvas></div>
        </div>
        <div class="chart-card">
          <h3>Pesan dengan Lampiran vs Teks Saja</h3>
          <div class="chart-box small"><canvas id="chartMedia"></canvas></div>
        </div>
      </div>

      <h2 class="section-title">🏆 Peringkat</h2>
      <div class="lists-grid">
        <div class="list-card"><h3>Pengirim Teraktif</h3><ul class="rank" id="listAuthors"></ul></div>
        <div class="list-card"><h3>Pesan Paling Banyak Di-like</h3><ul class="rank" id="listLiked"></ul></div>
        <div class="list-card"><h3>Pesan Paling Banyak Dikomentari</h3><ul class="rank" id="listCommented"></ul></div>
      </div>

      <div class="updated" id="updatedAt"></div>
    </div>
  </section>
</main>

<script type="module">
  import { createClient } from "https://cdn.jsdelivr.net/npm/@supabase/supabase-js/+esm"

  // Sama dengan yang dipakai di home.ejs
  const supabaseUrl = "https://rwinkckhijtbvfotqccl.supabase.co"
  const supabaseKey = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJ3aW5rY2toaWp0YnZmb3RxY2NsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEyMDk0NTYsImV4cCI6MjEwNjc4NTQ1Nn0.NTWj3r5YTeiox5AT5YIB5z4hHKKdSkgm0OdYz6lecPc"
  const supabase = createClient(supabaseUrl, supabaseKey)

  // ---------- Sidebar ----------
  const iconbar = document.querySelector('.iconbar')
  const menuToggle = document.getElementById('menuToggle')
  const menuPopup = document.getElementById('menuPopup')
  document.querySelector('.iconbar__toggle').addEventListener('click', () => {
    iconbar.classList.toggle('open')
    localStorage.setItem('iconbar-open', iconbar.classList.contains('open'))
  })
  if (localStorage.getItem('iconbar-open') === 'true') iconbar.classList.add('open')
  menuToggle.addEventListener('click', (e) => { e.stopPropagation(); menuPopup.classList.toggle('open') })
  document.addEventListener('click', (e) => {
    if (!menuPopup.contains(e.target) && e.target !== menuToggle) menuPopup.classList.remove('open')
  })

  // ---------- Helpers ----------
  const $ = (id) => document.getElementById(id)
  const nf = (n, max = 0) => Number(n || 0).toLocaleString('id-ID', { maximumFractionDigits: max })
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]))
  const DAYS = ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu', 'Minggu']
  const DAYS_SHORT = ['Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab', 'Min']
  const TZ = 'Asia/Jakarta'

  function renderCards(el, cards) {
    el.innerHTML = cards.map(c => `
      <div class="stat-card ${c.cls || ''}">
        <div class="label">${esc(c.label)}</div>
        <div class="value">${esc(c.value)}</div>
        <div class="hint">${esc(c.hint || '')}</div>
      </div>`).join('')
  }

  function renderList(el, rows, textKey, numKey, suffix) {
    if (!rows || !rows.length) { el.innerHTML = '<li class="empty">Belum ada data</li>'; return }
    el.innerHTML = rows.map((r, i) => `
      <li><span class="txt">${i + 1}. ${esc(r[textKey])}</span><span class="num">${nf(r[numKey])} ${suffix}</span></li>`).join('')
  }

  const baseOpts = {
    responsive: true, maintainAspectRatio: false,
    scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
  }
  const pieOpts = { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }

  let charts = {}
  let data = null
  let range = 14
  function mk(id, cfg) { if (charts[id]) charts[id].destroy(); charts[id] = new Chart($(id), cfg) }

  function drawCharts() {
    const daily = data.daily.slice(-range)
    mk('chartDaily', {
      type: 'line',
      data: {
        labels: daily.map(d => { const [y, m, dd] = d.date.split('-'); return `${+dd}/${+m}` }),
        datasets: [
          { label: 'Pesan', data: daily.map(d => d.messages), borderColor: '#667eea', backgroundColor: 'rgba(102,126,234,.18)', fill: true, tension: .35, pointRadius: 3 },
          { label: 'Komentar', data: daily.map(d => d.comments), borderColor: '#f59e0b', backgroundColor: 'rgba(245,158,11,.12)', fill: true, tension: .35, pointRadius: 3 }
        ]
      },
      options: { ...baseOpts, plugins: { legend: { position: 'bottom' } } }
    })

    mk('chartWeekday', {
      type: 'bar',
      data: { labels: DAYS_SHORT, datasets: [{ label: 'Pesan', data: data.weekday, backgroundColor: '#a1c4fd', borderRadius: 6 }] },
      options: { ...baseOpts, plugins: { legend: { display: false } } }
    })

    mk('chartHour', {
      type: 'bar',
      data: { labels: data.hour.map((_, i) => String(i).padStart(2, '0')), datasets: [{ label: 'Pesan', data: data.hour, backgroundColor: '#764ba2', borderRadius: 4 }] },
      options: { ...baseOpts, plugins: { legend: { display: false } } }
    })

    const m = data.messages
    mk('chartAnon', {
      type: 'doughnut',
      data: { labels: ['Anonim', 'Bernama'], datasets: [{ data: [m.anonymous, m.total - m.anonymous], backgroundColor: ['#c2e9fb', '#667eea'] }] },
      options: pieOpts
    })
    mk('chartMedia', {
      type: 'doughnut',
      data: { labels: ['Dengan lampiran', 'Teks saja'], datasets: [{ data: [m.with_file, m.total - m.with_file], backgroundColor: ['#764ba2', '#a1c4fd'] }] },
      options: pieOpts
    })
  }

  function render() {
    const m = data.messages, c = data.comments
    const maxW = Math.max(...data.weekday), maxH = Math.max(...data.hour)
    const busyDay = maxW > 0 ? DAYS[data.weekday.indexOf(maxW)] : '–'
    const busyHour = maxH > 0 ? String(data.hour.indexOf(maxH)).padStart(2, '0') + ':00' : '–'
    const pct = (a, b) => b > 0 ? Math.round(a / b * 100) + '%' : '0%'
    const since = m.first_at
      ? 'Sejak ' + new Date(m.first_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric', timeZone: TZ })
      : 'Belum ada pesan'
    const now = new Date()

    renderCards($('gridMessages'), [
      { label: 'Total Pesan Diterima', value: nf(m.total), hint: since, cls: 'total' },
      { label: 'Pesan Hari Ini', value: nf(m.today), hint: now.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', timeZone: TZ }) },
      { label: 'Pesan Minggu Ini', value: nf(m.week), hint: 'Senin – Minggu' },
      { label: 'Pesan Bulan Ini', value: nf(m.month), hint: now.toLocaleDateString('id-ID', { month: 'long', year: 'numeric', timeZone: TZ }) },
      { label: 'Rata-rata Pesan / Hari', value: nf(m.avg_per_day, 2), hint: `dari ${nf(m.active_days)} hari` },
      { label: 'Hari Tersibuk', value: busyDay, hint: maxW ? nf(maxW) + ' pesan' : '' },
      { label: 'Jam Tersibuk', value: busyHour, hint: maxH ? nf(maxH) + ' pesan' : '' },
      { label: 'Pesan Anonim', value: nf(m.anonymous), hint: pct(m.anonymous, m.total) + ' dari total' },
      { label: 'Pesan + Lampiran', value: nf(m.with_file), hint: pct(m.with_file, m.total) + ' dari total' },
      { label: 'Pesan di-Pin', value: nf(m.pinned), hint: '' }
    ])

    renderCards($('gridComments'), [
      { label: 'Total Komentar', value: nf(c.total), hint: '', cls: 'total' },
      { label: 'Komentar Hari Ini', value: nf(c.today), hint: '' },
      { label: 'Komentar Minggu Ini', value: nf(c.week), hint: '' },
      { label: 'Komentar Bulan Ini', value: nf(c.month), hint: '' },
      { label: 'Rata-rata Komentar / Pesan', value: nf(c.avg_per_message, 2), hint: '' },
      { label: 'Total Like', value: nf(m.likes_total), hint: m.total ? 'rata-rata ' + nf(m.likes_total / m.total, 1) + ' / pesan' : '' },
      { label: 'Komentar + Lampiran', value: nf(c.with_file), hint: '' },
      { label: 'Komentar Suara', value: nf(c.with_voice), hint: '' }
    ])

    drawCharts()
    renderList($('listAuthors'), data.top_authors, 'author', 'total', 'pesan')
    renderList($('listLiked'), data.top_liked, 'text', 'likes_count', '👍')
    renderList($('listCommented'), data.top_commented, 'text', 'total', '💬')
    $('updatedAt').textContent = 'Diperbarui ' + new Date(data.generated_at).toLocaleString('id-ID', { timeZone: TZ }) + ' WIB'
  }

  async function load() {
    const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || TZ
    const { data: res, error } = await supabase.rpc('get_analytics', { tz })
    if (error) {
      $('stateMsg').style.display = 'block'
      $('stateMsg').textContent = 'Gagal memuat data: ' + error.message + ' (pastikan SQL get_analytics sudah dijalankan di Supabase)'
      return
    }
    data = res
    $('stateMsg').style.display = 'none'
    $('content').style.display = 'block'
    render()
  }

  $('rangeSwitch').addEventListener('click', (e) => {
    const btn = e.target.closest('button[data-range]')
    if (!btn || !data) return
    range = Number(btn.dataset.range)
    document.querySelectorAll('#rangeSwitch button').forEach(b => b.classList.toggle('active', b === btn))
    drawCharts()
  })

  // Realtime: refresh saat ada pesan / komentar / like baru
  let timer
  const refresh = () => { clearTimeout(timer); timer = setTimeout(load, 400) }
  supabase.channel('analytics-channel')
    .on('postgres_changes', { event: '*', schema: 'public', table: 'messages' }, refresh)
    .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'comments' }, refresh)
    .subscribe()

  load()
</script>

</body>
</html>
