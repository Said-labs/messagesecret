<script>
// Ambil semua tombol yang punya data-modal
const modalButtons = document.querySelectorAll('[data-modal]');
const menuPopup = document.getElementById('menuPopup');

// Event klik untuk buka modal
modalButtons.forEach(btn => {
  btn.addEventListener('click', () => {
    const modalId = 'modal-' + btn.dataset.modal; // contoh: modal-about
    const modal = document.getElementById(modalId);
    if (modal) {
      modal.classList.add('open'); // kasih class open biar muncul
    }
    menuPopup.classList.remove('open'); // tutup popup menu setelah pilih
  });
});

// Tombol tutup di dalam modal
document.querySelectorAll('[data-close-modal]').forEach(btn => {
  btn.addEventListener('click', () => {
    btn.closest('.modal-overlay').classList.remove('open');
  });
});

// Tutup modal kalau klik area overlay (gelap di luar box)
document.querySelectorAll('.modal-overlay').forEach(overlay => {
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) {
      overlay.classList.remove('open');
    }
  });
});

// Tutup modal dengan tombol Escape
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    document.querySelectorAll('.modal-overlay.open').forEach(o => o.classList.remove('open'));
    menuPopup.classList.remove('open');
  }
});


  document.addEventListener("DOMContentLoaded", () => {
  const iconbar = document.querySelector(".iconbar");
  const toggleBtn = document.querySelector(".iconbar__toggle");
  const items = document.querySelectorAll(".iconbar__item");

  // Satu tombol di header: buka kalau tertutup, tutup kalau terbuka
  if (toggleBtn) {
    toggleBtn.addEventListener("click", () => {
      iconbar.classList.toggle("open");
      localStorage.setItem(
        "iconbar-open",
        iconbar.classList.contains("open")
      );
    });
  }

  // Ingat state terakhir
  if (localStorage.getItem("iconbar-open") === "true") {
    iconbar.classList.add("open");
  }

  // Set item aktif saat diklik
  items.forEach((item) => {
    item.addEventListener("click", () => {
      items.forEach((i) => i.classList.remove("active"));
      item.classList.add("active");
    });
  });
});

 if (menuToggle && menuPopup) {
    menuToggle.addEventListener("click", (e) => {
      e.stopPropagation()
      menuPopup.classList.toggle("open")
    })
    document.addEventListener("click", (e) => {
      if (!menuPopup.contains(e.target) && e.target !== menuToggle) {
        menuPopup.classList.remove("open")
      }
    })
  }

   document.querySelectorAll(".social-links a").forEach((icon) => {
    icon.addEventListener("click", () => {
      icon.classList.toggle("icon-zoomed")
    })
  })


</script>

