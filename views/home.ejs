    <div class="social-links">
      <a href="https://github.com/Said-labs" target="_blank" rel="noopener"><i class="fab fa-github"></i></a>
      <a href="https://instagram.com/saidazizv" target="_blank" rel="noopener"><i class="fab fa-instagram"></i></a>
      <a href="https://linkedin.com/in/sa-id-6037033b8" target="_blank" rel="noopener"><i class="fab fa-linkedin"></i></a>
      <a href="https://www.google.com/maps/place/Bandung,+Kota+Bandung,+Jawa+Barat/@-6.8954979,107.4814193,11z" target="_blank" rel="noopener"><i class="fas fa-map-marker-alt"></i></a>
    </div>
  </header>

  <!-- Kirim pesan -->
  <form id="messageForm" class="form-send">
    <div class="form-group">
      <input type="text" name="author" maxlength="50" placeholder="Name (Opsional)">
    </div>
    <div class="form-group">
      <textarea name="text" id="msgText" maxlength="1000" placeholder="Write your message here...." required></textarea>
      <div class="char-count" id="charCount">0 / 1000</div>
    </div>
    <div class="form-group">
      <input type="file" name="file" accept="image/*,video/*,audio/*">
    </div>
    <button type="submit" id="sendBtn">Send</button>
  </form>

  <!-- Cari pesan -->
  <form id="searchForm" class="form-search">
    <input type="text" name="author" placeholder="Look for a name...">
    <input type="text" name="pesan" placeholder="Look for the message hereee...">
    <input type="date" name="date">
    <button type="submit">Search message</button>
    <button type="button" class="btn-reset" id="resetSearch">Reset</button>
  </form>

  <!-- Timeline -->
  <div id="messageTimeline"></div>
  <button class="load-more" id="loadMore" style="display:none;">Muat lebih banyak</button>
</main>

<script type="module">
  import { createClient } from "https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm"

  const supabaseUrl = "https://rwinkckhijtbvfotqccl.supabase.co"
  const supabaseKey = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJ3aW5rY2toaWp0YnZmb3RxY2NsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEyMDk0NTYsImV4cCI6MjEwNjc4NTQ1Nn0.NTWj3r5YTeiox5AT5YIB5z4hHKKdSkgm0OdYz6lecPc"
  const supabase = createClient(supabaseUrl, supabaseKey)

  // ---------- Konstanta & helper ----------
  const PAGE = 10
  const MAX_FILE = 10 * 1024 * 1024
  const MSG_COOLDOWN = 30
  const CMT_COOLDOWN = 10
  const $ = (id) => document.getElementById(id)
  const timeline = $('messageTimeline')

  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]))
  const safeUrl = (u) => { try { const x = new URL(u); return x.protocol === 'https:' ? x.href : null } catch { return null } }
  const uuid = () => (crypto.randomUUID ? crypto.randomUUID() : 'd' + Date.now().toString(36) + Math.random().toString(36).slice(2) + Math.random().toString(36).slice(2))

  let toastTimer
  function toast(msg) {
    const t = $('toast'); t.textContent = msg; t.classList.add('show')
    clearTimeout(toastTimer); toastTimer = setTimeout(() => t.classList.remove('show'), 2800)
  }

  // ID perangkat (dipakai untuk like, laporan, dan hapus pesan sendiri)
  let deviceId = localStorage.getItem('sw_device')
  if (!deviceId) { deviceId = uuid(); localStorage.setItem('sw_device', deviceId) }
  const getMine = () => { try { return JSON.parse(localStorage.getItem('sw_mine') || '[]') } catch { return [] } }
  const addMine = (id) => { const a = getMine(); a.push(id); localStorage.setItem('sw_mine', JSON.stringify(a.slice(-200))) }

  // ---------- State ----------
  let shown = PAGE
  let filters = { author: '', pesan: '', date: '' }
  let isAdmin = false
  let likedSet = new Set()
  let sending = false

  // ---------- Sidebar ----------
  const iconbar = document.querySelector('.iconbar')
  const menuToggle = $('menuToggle')
  const menuPopup = $('menuPopup')
  document.querySelector('.iconbar__toggle').addEventListener('click', () => {
    iconbar.classList.toggle('open')
    localStorage.setItem('iconbar-open', iconbar.classList.contains('open'))
  })
  if (localStorage.getItem('iconbar-open') === 'true') iconbar.classList.add('open')
  menuToggle.addEventListener('click', (e) => { e.stopPropagation(); menuPopup.classList.toggle('open') })
  document.addEventListener('click', (e) => { if (!menuPopup.contains(e.target) && e.target !== menuToggle) menuPopup.classList.remove('open') })
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') menuPopup.classList.remove('open') })
  document.querySelectorAll('.social-links a').forEach(a => a.addEventListener('click', () => a.classList.toggle('icon-zoomed')))
  window.addEventListener('load', () => setTimeout(() => $('loader').classList.add('hidden'), 1200))

  // ---------- Render ----------
  function renderFile(url) {
    const u = safeUrl(url); if (!u) return ''
    const p = new URL(u).pathname.toLowerCase(); const src = esc(u)
    if (/\.(mp4|webm|mov)$/.test(p)) return `<video controls preload="metadata" src="${src}"></video>`
    if (/\.(mp3|wav|ogg|m4a)$/.test(p)) return `<audio controls preload="none" src="${src}"></audio>`
    if (/\.(jpe?g|png|gif|webp)$/.test(p)) return `<img loading="lazy" src="${src}" alt="Lampiran">`
    return `<a href="${src}" target="_blank" rel="noopener">Download File</a>`
  }

  function cardHtml(msg) {
    const mine = getMine().includes(msg.id)
    const liked = likedSet.has(msg.id)
    const comments = (msg.comments || []).map(c => `
      <p><strong>${esc(c.author || 'Anonim')}:</strong> ${esc(c.text)}
        ${isAdmin ? `<button class="c-del" data-action="del-comment" data-id="${c.id}">hapus</button>` : ''}</p>
      ${c.file_url ? renderFile(c.file_url) : ''}
      ${c.voice_url && safeUrl(c.voice_url) ? `<audio controls src="${esc(c.voice_url)}"></audio>` : ''}`).join('')

    return `
      <div class="card ${msg.is_pinned ? 'pinned' : ''}" data-id="${msg.id}">
        <div class="card-header">
          <span class="author">${esc(msg.author || 'Anonim')}</span>
          <span class="date">${new Date(msg.created_at).toLocaleString('id-ID')}</span>
        </div>
        <div class="card-body"><p>${esc(msg.text)}</p></div>
        ${msg.file_url ? renderFile(msg.file_url) : ''}
        <div class="card-footer">
          <button data-action="like" class="${liked ? 'liked' : ''}">👍 Like (${msg.likes_count || 0})</button>
          ${isAdmin ? `<button data-action="pin" data-pinned="${msg.is_pinned ? 1 : 0}">📌 ${msg.is_pinned ? 'Lepas Pin' : 'Pin'}</button>` : ''}
          <button data-action="copy">Copy</button>
          <button data-action="share">🔗 Share</button>
          <button data-action="report">🚩 Laporkan</button>
          ${(mine || isAdmin) ? `<button class="danger" data-action="delete">🗑 Hapus</button>` : ''}
        </div>
        <div class="comments">
          ${comments}
          <form class="comment-form" data-id="${msg.id}">
            <input type="text" name="author" maxlength="50" placeholder="Nama">
            <input type="text" name="text" maxlength="500" placeholder="Tulis komentar..." required>
            <input type="file" name="file" accept="image/*,video/*,audio/*">
            <button type="submit">Kirim</button>
          </form>
        </div>
      </div>`
  }

  // ---------- Ambil data ----------
  async function loadMessages() {
    let q = supabase.from('messages')
      .select('id, author, text, created_at, file_url, likes_count, is_pinned, comments(id, author, text, file_url, voice_url, created_at)', { count: 'exact' })
      .order('is_pinned', { ascending: false })
      .order('created_at', { ascending: false })
      .order('created_at', { referencedTable: 'comments', ascending: true })

    if (filters.author) q = q.ilike('author', `%${filters.author}%`)
    if (filters.pesan) q = q.ilike('text', `%${filters.pesan}%`)
    if (filters.date) {
      const start = new Date(filters.date + 'T00:00:00')
      const end = new Date(start.getTime() + 86400000)
      q = q.gte('created_at', start.toISOString()).lt('created_at', end.toISOString())
    }

    const { data, count, error } = await q.range(0, shown - 1)
    if (error) { timeline.innerHTML = `<p class="empty-state">Gagal memuat pesan: ${esc(error.message)}</p>`; return }

    if (!data.length) {
      const filtered = filters.author || filters.pesan || filters.date
      timeline.innerHTML = `<p class="empty-state">${filtered ? 'Tidak ada pesan yang cocok.' : 'Belum ada pesan rahasia.'}</p>`
    } else {
      timeline.innerHTML = data.map(cardHtml).join('')
    }
    $('loadMore').style.display = (count && data.length < count) ? 'block' : 'none'
  }

  async function checkAdmin() {
    const { data: { session } } = await supabase.auth.getSession()
    if (!session) isAdmin = false
    else { const { data } = await supabase.rpc('is_admin'); isAdmin = data === true }
    $('adminBadge').style.display = isAdmin ? 'block' : 'none'
  }

  async function loadMyLikes() {
    const { data } = await supabase.rpc('my_likes', { p_device: deviceId })
    likedSet = new Set(data || [])
  }

  async function uploadFile(folder, file) {
    const name = file.name.replace(/[^a-zA-Z0-9._-]/g, '_')
    const { data, error } = await supabase.storage.from('uploads').upload(`${folder}/${Date.now()}_${name}`, file)
    if (error) throw new Error('Upload gagal: ' + error.message)
    return supabase.storage.from('uploads').getPublicUrl(data.path).data.publicUrl
  }

  function checkFile(file) {
    if (!file || !file.size) return null
    if (file.size > MAX_FILE) return 'Ukuran file maksimal 10 MB'
    if (!/^(image|video|audio)\//.test(file.type)) return 'Hanya gambar, video, atau audio'
    return null
  }

  // ---------- Kirim pesan ----------
  const form = $('messageForm')
  const msgText = $('msgText')
  const updateCount = () => { $('charCount').textContent = `${msgText.value.length} / 1000` }
  msgText.addEventListener('input', updateCount)

  function updateCooldown() {
    if (sending) return
    const last = Number(localStorage.getItem('sw_last') || 0)
    const left = Math.ceil((last + MSG_COOLDOWN * 1000 - Date.now()) / 1000)
    const btn = $('sendBtn')
    if (left > 0) { btn.disabled = true; btn.textContent = `Tunggu ${left}s`; setTimeout(updateCooldown, 500) }
    else { btn.disabled = false; btn.textContent = 'Send' }
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    if (sending) return
    const fd = new FormData(form)
    const author = fd.get('author'), text = (fd.get('text') || '').trim(), file = fd.get('file')
    if (!text) return toast('Pesan tidak boleh kosong')
    const fileErr = checkFile(file); if (fileErr) return toast(fileErr)

    sending = true
    $('sendBtn').disabled = true; $('sendBtn').textContent = 'Mengirim…'
    try {
      const file_url = (file && file.size > 0) ? await uploadFile('messages', file) : null
      const { data, error } = await supabase.rpc('send_message', { p_author: author, p_text: text, p_file_url: file_url, p_token: deviceId })
      if (error) throw error
      addMine(data)
      localStorage.setItem('sw_last', Date.now())
      form.reset(); updateCount()
      toast('Pesan terkirim ✅')
      shown = Math.max(shown, PAGE)
      await loadMessages()
    } catch (err) {
      toast(err.message || 'Gagal mengirim pesan')
    } finally {
      sending = false; updateCooldown()
    }
  })

  // ---------- Komentar ----------
  timeline.addEventListener('submit', async (e) => {
    const f = e.target.closest('form.comment-form'); if (!f) return
    e.preventDefault()
    const last = Number(localStorage.getItem('sw_last_c') || 0)
    const left = Math.ceil((last + CMT_COOLDOWN * 1000 - Date.now()) / 1000)
    if (left > 0) return toast(`Tunggu ${left} detik sebelum berkomentar lagi`)

    const fd = new FormData(f)
    const text = (fd.get('text') || '').trim(), file = fd.get('file')
    if (!text) return toast('Komentar tidak boleh kosong')
    const fileErr = checkFile(file); if (fileErr) return toast(fileErr)

    const btn = f.querySelector('button'); btn.disabled = true
    try {
      const file_url = (file && file.size > 0) ? await uploadFile('comments', file) : null
      const { error } = await supabase.rpc('send_comment', { p_message_id: f.dataset.id, p_author: fd.get('author'), p_text: text, p_file_url: file_url, p_token: deviceId })
      if (error) throw error
      localStorage.setItem('sw_last_c', Date.now())
      toast('Komentar terkirim ✅')
      await loadMessages()
    } catch (err) { toast(err.message || 'Gagal mengirim komentar'); btn.disabled = false }
  })

  // ---------- Aksi tombol (like, pin, copy, share, report, hapus) ----------
  timeline.addEventListener('click', async (e) => {
    const btn = e.target.closest('button[data-action]'); if (!btn) return
    const card = btn.closest('.card'); const id = card.dataset.id
    const text = card.querySelector('.card-body p').textContent

    switch (btn.dataset.action) {
      case 'like': {
        const { data, error } = await supabase.rpc('toggle_like', { p_message_id: id, p_device: deviceId })
        if (error) return toast(error.message)
        data.liked ? likedSet.add(id) : likedSet.delete(id)
        btn.classList.toggle('liked', data.liked)
        btn.textContent = `👍 Like (${data.likes_count})`
        break
      }
      case 'pin': {
        const { error } = await supabase.from('messages').update({ is_pinned: btn.dataset.pinned !== '1' }).eq('id', id)
        if (error) return toast(error.message)
        loadMessages(); break
      }
      case 'copy':
        navigator.clipboard.writeText(text).then(() => toast('Pesan berhasil dicopy!')).catch(() => toast('Gagal menyalin'))
        break
      case 'share':
        if (navigator.share) navigator.share({ title: 'SecretWall', text, url: location.origin }).catch(() => {})
        else navigator.clipboard.writeText(`${text}\n${location.origin}`).then(() => toast('Teks & link disalin'))
        break
      case 'report': {
        const reason = prompt('Alasan laporan (opsional):')
        if (reason === null) return
        const { error } = await supabase.rpc('report_message', { p_message_id: id, p_reason: reason, p_device: deviceId })
        toast(error ? error.message : 'Laporan terkirim, terima kasih 🙏')
        break
      }
      case 'delete': {
        if (!confirm('Hapus pesan ini?')) return
        const res = isAdmin
          ? await supabase.from('messages').delete().eq('id', id)
          : await supabase.rpc('delete_own_message', { p_id: id, p_token: deviceId })
        if (res.error) return toast(res.error.message)
        toast('Pesan dihapus'); loadMessages(); break
      }
      case 'del-comment': {
        if (!confirm('Hapus komentar ini?')) return
        const { error } = await supabase.from('comments').delete().eq('id', btn.dataset.id)
        if (error) return toast(error.message)
        loadMessages(); break
      }
    }
  })

  // ---------- Pencarian & pagination ----------
  $('searchForm').addEventListener('submit', (e) => {
    e.preventDefault()
    const fd = new FormData(e.target)
    filters = { author: (fd.get('author') || '').trim(), pesan: (fd.get('pesan') || '').trim(), date: fd.get('date') || '' }
    shown = PAGE; loadMessages()
  })
  $('resetSearch').addEventListener('click', () => {
    $('searchForm').reset(); filters = { author: '', pesan: '', date: '' }; shown = PAGE; loadMessages()
  })
  $('loadMore').addEventListener('click', () => { shown += PAGE; loadMessages() })

  // ---------- Realtime (tidak mengganggu saat sedang mengetik) ----------
  let reloadTimer, pendingReload = false
  function scheduleReload() {
    clearTimeout(reloadTimer)
    reloadTimer = setTimeout(() => {
      const a = document.activeElement
      if (a && timeline.contains(a) && a.matches('input,textarea')) { pendingReload = true; return }
      loadMessages()
    }, 500)
  }
  timeline.addEventListener('focusout', () => {
    if (!pendingReload) return
    pendingReload = false
    setTimeout(() => { if (!timeline.contains(document.activeElement)) loadMessages() }, 200)
  })
  supabase.channel('messages-channel')
    .on('postgres_changes', { event: '*', schema: 'public', table: 'messages' }, scheduleReload)
    .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'comments' }, scheduleReload)
    .subscribe()

  supabase.auth.onAuthStateChange(() => { checkAdmin().then(loadMessages) })

  // ---------- Mulai ----------
  ;(async () => {
    await checkAdmin()
    await loadMyLikes()
    await loadMessages()
    updateCooldown()
  })()
</script>

</body>
</html>
