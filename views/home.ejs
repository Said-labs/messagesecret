  <!-- Timeline pesan -->
  <div id="messageTimeline"></div>

  <script type="module">
    import { createClient } from "https://cdn.jsdelivr.net/npm/@supabase/supabase-js/+esm"

    const supabaseUrl = "https://rwinkckhijtbvfotqccl.supabase.co"
    const supabaseKey = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJ3aW5rY2toaWp0YnZmb3RxY2NsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEyMDk0NTYsImV4cCI6MjEwNjc4NTQ1Nn0.NTWj3r5YTeiox5AT5YIB5z4hHKKdSkgm0OdYz6lecPc"
    const supabase = createClient(supabaseUrl, supabaseKey)

    const form = document.getElementById('messageForm')
    const timeline = document.getElementById('messageTimeline')

    // kirim pesan rahasia
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const formData = new FormData(form)
      const author = formData.get('author')
      const text = formData.get('text')
      const file = formData.get('file')

      let file_url = null
      if (file && file.size > 0) {
        const { data, error } = await supabase.storage
          .from('uploads')
          .upload(`messages/${Date.now()}_${file.name}`, file)
              if (error) {
  alert("Upload gagal: " + error.message)
} else {
  file_url = supabase.storage.from('uploads').getPublicUrl(data.path).data.publicUrl
}
      }




      await supabase.from('messages').insert([{ author, text, file_url }])
      loadMessages()
    })

    // ambil pesan + komentar + likes
    async function loadMessages() {
      const { data: messages } = await supabase
        .from('messages')
        .select('id, author, text, created_at, file_url, likes_count, comments(id, author, text, file_url, voice_url)')
        .order('created_at', { ascending: false })

      timeline.innerHTML = ''
      messages.forEach(msg => {
        timeline.innerHTML += `
          <div class="card">
            <div class="card-header">
              <span class="author">${msg.author || "Anonim"}</span>
              <span class="date">${new Date(msg.created_at).toLocaleString()}</span>
            </div>
            <div class="card-body"><p>${msg.text}</p></div>
            ${msg.file_url ? renderFile(msg.file_url) : ""}
            <div class="card-footer">
              <button onclick="likeMessage('${msg.id}')">👍 Like (${msg.likes_count || 0})</button>
              <button onclick="pinMessage('${msg.id}')">📌 Pin</button>
              <button onclick="copyMessage('${msg.text}')">Copy</button>
              <button onclick="shareMessage('${msg.text}')">🔗 Share</button>
            </div>
            <div class="comments">
              ${(msg.comments || []).map(c => `
                <p><strong>${c.author || "Anonim"}:</strong> ${c.text}</p>
                ${c.file_url ? renderFile(c.file_url) : ""}
                ${c.voice_url ? `<audio controls src="${c.voice_url}"></audio>` : ""}
              `).join('')}
              <form onsubmit="commentMessage(event, '${msg.id}')">
                <input type="text" name="author" placeholder="Nama">
                <input type="text" name="text" placeholder="Tulis komentar..." required>
                <input type="file" name="file" accept="image/*,video/*,audio/*">
                <button type="submit">Kirim</button>
              </form>
            </div>
          </div>`
      })
    }

    


    const searchForm = document.getElementById('searchForm')

searchForm.addEventListener('submit', async (e) => {
  e.preventDefault()
  const formData = new FormData(searchForm)
  const author = formData.get('author')
  const pesan = formData.get('pesan')
  const date = formData.get('date')

  let query = supabase.from('messages').select('*').order('created_at', { ascending: false })

  if (author) {
    query = query.ilike('author', `%${author}%`)   // cari berdasarkan nama
  }
  if (pesan) {
    query = query.ilike('text', `%${pesan}%`)      // cari berdasarkan isi pesan
  }
  if (date) {
    query = query.gte('created_at', date).lt('created_at', date + 'T23:59:59') // filter tanggal
  }

  const { data: messages } = await query
  renderMessages(messages)
})

function renderMessages(messages) {
  if (!messages || messages.length === 0) {
    timeline.innerHTML = "<p>Belum ada pesan rahasia.</p>"
    return
  }
  timeline.innerHTML = ''
  messages.forEach(msg => {
    timeline.innerHTML += `
        <div class="card ${msg.is_pinned ? 'pinned' : ''}">
        <div class="card-header">
          <span class="author">${msg.author || "Anonim"}</span>
          <span class="date">${new Date(msg.created_at).toLocaleString()}</span>
        </div>
        <div class="card-body"><p>${msg.text}</p></div>
        ${msg.file_url ? renderFile(msg.file_url) : ""}
        

      </div>`
     

  })
}


    // helper render file
    function renderFile(url) {
      if (url.endsWith('.mp4') || url.endsWith('.webm')) return `<video controls src="${url}"></video>`
      if (url.endsWith('.mp3') || url.endsWith('.wav')) return `<audio controls src="${url}"></audio>`
      if (url.match(/\.(jpg|jpeg|png|gif)$/)) return `<img src="${url}" alt="File">`
      return `<a href="${url}" target="_blank">Download File</a>`
    }

    // fungsi tambahan
    window.likeMessage = async (id) => {
      await supabase.rpc('increment_likes', { message_id: id })
      loadMessages()
    }

    window.pinMessage = async (id) => {
  await supabase.from('messages').update({ is_pinned: true }).eq('id', id)
  loadMessages()
}





    window.commentMessage = async (e, id) => {
      e.preventDefault()
      const formData = new FormData(e.target)
      const author = formData.get('author')
      const text = formData.get('text')
      const file = formData.get('file')

      let file_url = null
      if (file && file.size > 0) {
        const { data, error } = await supabase.storage
          .from('uploads')
          .upload(`comments/${Date.now()}_${file.name}`, file)
      
      if (error) {
  alert("Upload komentar gagal: " + error.message)
} else {
  file_url = supabase.storage.from('uploads').getPublicUrl(data.path).data.publicUrl
}
      }



      await supabase.from('comments').insert([{ message_id: id, author, text, file_url }])
      loadMessages()
    }

    window.copyMessage = (text) => {
      navigator.clipboard.writeText(text).then(() => alert("Pesan berhasil dicopy!"))
    }

    window.shareMessage = (text) => {
      alert("Bagikan pesan: " + text)
    }

    // realtime listener
    supabase
      .channel('messages-channel')
      .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'messages' }, payload => {
        loadMessages()
      })
      .subscribe()

    loadMessages () 



  </script>

