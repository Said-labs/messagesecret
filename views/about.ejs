<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SecretWall — About</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" type="image/png" href="/uploads/logo.png">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    .doc { max-width: 820px; width: 94%; margin: 30px auto; }
    .doc-card { background: var(--card-bg); border-radius: 12px; padding: 22px; margin-bottom: 18px; box-shadow: 0 0 15px rgba(163,191,250,.25); animation: fadeIn .6s ease forwards; }
    .doc-card h2 { margin: 0 0 10px; font-family: var(--font-display); color: var(--accent-2); font-size: 1.1rem; }
    .doc-card p, .doc-card li { color: #444; line-height: 1.7; font-size: 14.5px; }
    .doc-card p { margin: 0 0 8px; }
    .doc-card a { color: var(--accent); font-weight: 500; }
    .doc-meta { text-align: center; font-size: 12.5px; color: #888; }
    .feature-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 12px; margin-top: 10px; }
    .feature-item { background: #fff; border: 1px solid rgba(163,191,250,.4); border-radius: 10px; padding: 14px; transition: transform .2s ease, box-shadow .25s ease; }
    .feature-item:hover { transform: translateY(-3px); box-shadow: 0 10px 22px rgba(102,126,234,.2); }
    .feature-item strong { display: block; color: var(--accent); margin-bottom: 4px; font-size: 14px; }
    .feature-item span { font-size: 13px; color: #666; line-height: 1.5; }
    .tag-list { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
    .tag { background: linear-gradient(90deg, #a1c4fd, #c2e9fb); color: #111; font-size: 12.5px; font-weight: 600; padding: 5px 12px; border-radius: 999px; }
  </style>
</head>
<body>

<aside class="iconbar">
  <div class="iconbar__header">
