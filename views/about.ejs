      <svg class="iconbar__mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" width="20" height="20"><path d="M12 2 3 12l9 10 9-10z"/><circle cx="12" cy="12" r="2.4" fill="currentColor" stroke="none"/></svg>
      <span class="iconbar__brand-text">SA'ID AZIZ</span>
    </div>
    <button class="iconbar__toggle" aria-label="Buka/tutup navbar">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="3" x2="9" y2="21"/></svg>
    </button>
  </div>

  <nav class="iconbar__nav">
    <a class="iconbar__item" href="/">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <span class="iconbar__label">Home</span>
      <span class="iconbar__tooltip">Home</span>
    </a>
    <a class="iconbar__item" href="/analytics">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="20" x2="4" y2="12"/><line x1="10" y1="20" x2="10" y2="6"/><line x1="16" y1="20" x2="16" y2="14"/><line x1="21" y1="20" x2="21" y2="9"/></svg>
      <span class="iconbar__label">Analytics</span>
      <span class="iconbar__tooltip">Analytics</span>
    </a>
  </nav>

  <div class="iconbar__bottom">
    <button class="iconbar__item iconbar__item--menu" id="menuToggle" type="button">
      <svg viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/></svg>
      <span class="iconbar__label">Menu</span>
      <span class="iconbar__tooltip">Menu</span>
    </button>
  </div>
</aside>

<div class="menu-popup" id="menuPopup">
  <a class="menu-popup__item" href="https://mail.google.com/mail/?view=cm&fs=1&to=saidaziz.expert@gmail.com&su=Support%20SecretWall" target="_blank" rel="noopener">Support</a>
  <a class="menu-popup__item" href="/about">About</a>
  <a class="menu-popup__item" href="/terms">Terms</a>
  <div class="menu-popup__footer">SecretWall v1.0 &middot; Rilis 2026</div>
